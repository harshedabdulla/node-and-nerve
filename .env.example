# Copy to .env and adjust. Never commit a real .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
FALKORDB_QUERY_TIMEOUT_MS=5000
FALKORDB_SOCKET_TIMEOUT_S=10
FALKORDB_CONNECT_TIMEOUT_S=3

# API keys with company scopes: "key=company1|company2,other-key=*".
# Keys must be at least 16 characters. Leave empty to disable auth (local only).
COMPANY_BRAIN_API_KEYS=

# Optional: AI agent over the contract tools (OpenRouter, OpenAI-compatible API).
# The engine and every investigation work without it.
# OPEN_ROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# AGENT_COMPANY_ID=kaveri-body-works

# Optional: Telegram bot. Create a bot with @BotFather, put its token here, run
# `company-brain telegram`, send /start to learn your chat id, then allow it below.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: evidence-graph links in agent/Telegram replies. Links open without an API
# key, so they are HMAC-signed with this secret and expire after 7 days. Use a long
# random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# PUBLIC_BASE_URL is where the API (uvicorn) is reachable from the reader's browser.
# TRACE_LINK_SECRET=
# PUBLIC_BASE_URL=http://localhost:8000
