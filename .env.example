# Copy to .env and adjust. Never commit a real .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
FALKORDB_QUERY_TIMEOUT_MS=5000
FALKORDB_SOCKET_TIMEOUT_S=10
FALKORDB_CONNECT_TIMEOUT_S=3

# API keys with company scopes: "key=company1|company2,other-key=*".
# Keys must be at least 16 characters. Leave empty to disable auth (local only).
COMPANY_BRAIN_API_KEYS=
